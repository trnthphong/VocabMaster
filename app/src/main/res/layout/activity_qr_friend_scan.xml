<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4046d8">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:textAppearance="@style/TextAppearance.VocabMaster.H3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        android:textColor="@color/white"
        app:title="Scan QR"
        app:titleTextColor="@color/white" />

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:alpha="0.1"
        android:rotation="-15"
        android:src="@drawable/qr_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.14"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:tint="@color/white" />

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:alpha="0.1"
        android:rotation="16"
        android:src="@drawable/scan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.84"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:tint="@color/white" />

    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:alpha="0.1"
        android:rotation="12"
        android:src="@drawable/friends"
        app:layout_constraintBottom_toTopOf="@id/btn_scan_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/white" />

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:alpha="0.1"
        android:rotation="-12"
        android:src="@drawable/mylibrary"
        app:layout_constraintBottom_toTopOf="@id/btn_scan_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.82"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/img_preview"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_rect_border"
        android:contentDescription="QR preview"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/qr_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:tint="@color/brand_primary" />

    <TextView
        android:id="@+id/text_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Kết bạn dễ dàng hơn với mã QR."
        android:textAppearance="@style/TextAppearance.VocabMaster.BodyMedium"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_preview" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan_camera"
        android:background="@drawable/button_login_neumorph"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="28dp"
        android:textColor="@color/bg_grey"
        android:text="Quét mã QR"
        app:backgroundTint="@null"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_status" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pick_image"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:text="Chọn ảnh từ thư viện"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_scan_camera" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
