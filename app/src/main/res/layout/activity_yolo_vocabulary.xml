<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4046d8">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#4046d8"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back"
        app:title="PHÂN TÍCH TỪ VỰNG TỪ ẢNH"
        app:titleTextColor="@color/white" />

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:alpha="0.1"
        android:rotation="-15"
        android:src="@drawable/camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:tint="@color/white" />

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:alpha="0.1"
        android:rotation="14"
        android:src="@drawable/scan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.88"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:tint="@color/white" />

    <ImageView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:alpha="0.1"
        android:rotation="12"
        android:src="@drawable/word"
        app:layout_constraintBottom_toTopOf="@id/btn_add_selected"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.18"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/white" />

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:alpha="0.1"
        android:rotation="-12"
        android:src="@drawable/mylibrary"
        app:layout_constraintBottom_toTopOf="@id/btn_add_selected"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.82"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/white" />

    <ImageView
        android:id="@+id/img_preview"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_rect_border"
        android:backgroundTint="@color/white"
        android:contentDescription="Selected image"
        android:scaleType="fitCenter"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/img_preview">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_image"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Chọn ảnh"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_yolo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Phân tích ảnh"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:text="Kết quả sẽ được trả ở đây."
        android:textAppearance="@style/TextAppearance.VocabMaster.Caption"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/layout_actions" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_results"

        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/btn_add_selected"
        app:layout_constraintTop_toBottomOf="@id/text_status" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_selected"
        android:background="@drawable/button_login_neumorph"
        android:layout_width="match_parent"
        app:backgroundTint="@null"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:enabled="false"
        android:text="Thêm từ đã chọn vào bộ từ"
        android:textAllCaps="false"
        android:textColor="@color/bg_grey"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
