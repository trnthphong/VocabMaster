<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_12"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="@dimen/elevation_low"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="84dp"
        android:padding="@dimen/spacing_16">

        <ImageView
            android:id="@+id/image_set_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_glass_card"
            android:padding="8dp"
            android:src="@drawable/flash_card"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/text_set_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_12"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.VocabMaster.H3"
            android:textColor="@color/text_primary"
            app:layout_constraintBottom_toTopOf="@id/text_set_subtitle"
            app:layout_constraintEnd_toStartOf="@id/image_next"
            app:layout_constraintStart_toEndOf="@id/image_set_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Personal Flashcards" />

        <TextView
            android:id="@+id/text_set_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/spacing_12"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.VocabMaster.BodyMedium"
            android:textColor="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/image_next"
            app:layout_constraintStart_toEndOf="@id/image_set_icon"
            app:layout_constraintTop_toBottomOf="@id/text_set_title"
            tools:text="3 thẻ · Bộ thẻ cá nhân" />

        <ImageView
            android:id="@+id/image_next"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
