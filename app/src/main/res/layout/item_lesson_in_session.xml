<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="4dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Lesson Badge (Shield-like) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_badge"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_glass_card"
            android:backgroundTint="#E3F2FD"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/text_lesson_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="53"
                android:textColor="#1976D2"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/text_lesson_type"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/text_lesson_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LESSON"
                android:textColor="#1976D2"
                android:textSize="9sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_lesson_number" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Stars -->
        <LinearLayout
            android:id="@+id/layout_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@id/layout_badge"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/image_star"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/star1"
                app:tint="#FFD600" />

            <TextView
                android:id="@+id/text_stars_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0/3"
                android:textColor="#757575"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Trophy icons for tests if needed -->
            <ImageView
                android:id="@+id/image_trophy_small_1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/trophy"
                android:visibility="gone"
                app:tint="#E0E0E0" />
            <ImageView
                android:id="@+id/image_trophy_small_2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/trophy"
                android:visibility="gone"
                app:tint="#E0E0E0" />
            <ImageView
                android:id="@+id/image_trophy_small_3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/trophy"
                android:visibility="gone"
                app:tint="#E0E0E0" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/text_lesson_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Listening: Câu hỏi bảng biểu"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/layout_stars"
            app:layout_constraintTop_toBottomOf="@id/layout_stars" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/text_lesson_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0/1 Section"
            android:textColor="#9E9E9E"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/layout_stars"
            app:layout_constraintTop_toBottomOf="@id/text_lesson_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
