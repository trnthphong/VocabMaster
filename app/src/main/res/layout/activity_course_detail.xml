<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4046d8"
    android:clipChildren="false">

    <!-- Header Background with random icons -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:alpha="0.1"
            android:rotation="-15"
            android:src="@drawable/open_book"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2"
            app:tint="@color/white" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:alpha="0.1"
            android:rotation="-15"
            android:src="@drawable/ranking"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.4"
            app:tint="@color/white" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:alpha="0.1"
            android:rotation="20"
            android:src="@drawable/puzzle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.1"
            app:tint="@color/white" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.1"
            android:rotation="10"
            android:src="@drawable/speedup"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.05"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.7"
            app:tint="@color/white" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:alpha="0.1"
            android:rotation="10"
            android:src="@drawable/language"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.95"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.8"
            app:tint="@color/white" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Progress Status Card with Mascot Overlay -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="22dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:id="@+id/text_course_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingEnd="92dp"
                            android:text="Tiến độ khóa học của bạn"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_progress_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:maxLines="2"
                            android:paddingEnd="92dp"
                            android:text="Bạn đang học đúng tiến độ!"
                            android:textAppearance="@style/TextAppearance.VocabMaster.H3"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:gravity="start" />

                        <!-- Timeline Progress Section -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="26dp"
                            android:minHeight="96dp"
                            android:paddingHorizontal="4dp">

                            <View
                                android:id="@+id/timeline_line"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:background="@drawable/bg_timeline_line"
                                app:layout_constraintBottom_toBottomOf="@id/dot_start"
                                app:layout_constraintEnd_toEndOf="@id/dot_end"
                                app:layout_constraintStart_toStartOf="@id/dot_start"
                                app:layout_constraintTop_toTopOf="@id/dot_start" />

                            <ImageView
                                android:id="@+id/dot_start"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_timeline_dot"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:layout_marginTop="8dp"/>

                            <TextView
                                android:id="@+id/label_start"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Bắt đầu"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/dot_start" />

                            <TextView
                                android:id="@+id/text_course_start_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="@id/label_start"
                                app:layout_constraintTop_toBottomOf="@id/label_start"/>

                            <ImageView
                                android:id="@+id/dot_mid"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_timeline_dot"
                                app:layout_constraintBottom_toBottomOf="@id/dot_start"
                                app:layout_constraintTop_toTopOf="@id/dot_start"
                                app:layout_constraintStart_toStartOf="@id/dot_start"
                                app:layout_constraintEnd_toEndOf="@id/dot_end"
                                app:layout_constraintHorizontal_bias="0.0" />

                            <TextView
                                android:id="@+id/text_course_current_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="0"
                                android:textColor="@color/blue"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:layout_constraintTop_toBottomOf="@id/dot_mid"
                                app:layout_constraintStart_toStartOf="@id/dot_mid"
                                app:layout_constraintEnd_toEndOf="@id/dot_mid" />

                            <TextView
                                android:id="@+id/label_current"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Hiện tại"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/dot_mid" />

                            <TextView
                                android:id="@+id/label_mid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="0%"
                                android:textColor="@color/blue"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/label_current" />

                            <ImageView
                                android:id="@+id/dot_end"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/finish_flag"
                                app:tint="@color/blue"
                                app:layout_constraintBottom_toBottomOf="@id/dot_start"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/dot_start" />

                            <TextView
                                android:id="@+id/label_end"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Mục tiêu"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/dot_end" />

                            <TextView
                                android:id="@+id/text_course_total_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="100"
                                android:textColor="@color/text_primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="@id/label_end"
                                app:layout_constraintTop_toBottomOf="@id/label_end"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Hidden legacy elements -->
                        <ProgressBar
                            android:id="@+id/progress_course_overview"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:visibility="gone" />
                        <TextView
                            android:id="@+id/text_course_overview_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:id="@+id/image_mascot"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="24dp"
                    android:layout_marginTop="26dp"
                    android:elevation="4dp"
                    android:contentDescription="Chú gấu cổ vũ tiến độ học"
                    android:src="@drawable/gau" />
            </FrameLayout>

            <!-- Main Content Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="#4DB4B4B4"
                    app:tabBackground="@drawable/tab_chrome_selector"
                    app:tabGravity="fill"
                    app:tabIndicatorHeight="0dp"
                    app:tabMode="fixed"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabSelectedTextColor="@color/bg_grey"
                    app:tabTextAppearance="@style/TextAppearance.VocabMaster.LabelMedium"
                    app:tabTextColor="#CCFFFFFF">

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Roadmap" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng quan" />

                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buổi học" />
                </com.google.android.material.tabs.TabLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white">

                    <!-- Roadmap Tab Content -->
                    <LinearLayout
                        android:id="@+id/layout_roadmap_tab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="visible">

                        <include
                            android:id="@+id/calendar_include"
                            layout="@layout/item_weekly_calendar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:text="Bài học hôm nay"
                            android:textAppearance="@style/TextAppearance.VocabMaster.H3" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_roadmap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:nestedScrollingEnabled="false" />

                        <ProgressBar
                            android:id="@+id/progress_roadmap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <!-- Overview Tab Content -->
                    <LinearLayout
                        android:id="@+id/layout_overview_tab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thông tin khóa học"
                            android:textAppearance="@style/TextAppearance.VocabMaster.H3" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:cardBackgroundColor="@color/surface_light"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:id="@+id/text_course_description_tab"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:text="Mô tả khóa học sẽ hiển thị ở đây."
                                android:textAppearance="@style/TextAppearance.VocabMaster.BodyMedium" />
                        </com.google.android.material.card.MaterialCardView>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_overview_units"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>

                    <!-- Sessions Tab Content -->
                    <LinearLayout
                        android:id="@+id/layout_sessions_tab"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Danh sách buổi học"
                            android:textAppearance="@style/TextAppearance.VocabMaster.H3" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recycler_sessions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
