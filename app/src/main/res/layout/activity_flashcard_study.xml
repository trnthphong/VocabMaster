<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light">

    <include
        layout="@layout/layout_gamification_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_light"
        app:layout_constraintTop_toBottomOf="@id/gamification_status_container"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/text_primary"
        app:title="Ôn tập Flashcard"
        app:titleTextColor="@color/text_primary" />

    <LinearLayout
        android:id="@+id/layout_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_24"
        android:layout_marginTop="@dimen/spacing_8"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <TextView
            android:id="@+id/text_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.VocabMaster.BodyMedium"
            android:textColor="@color/text_secondary"
            tools:text="1 / 12" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_study"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            app:indicatorColor="@color/brand_primary"
            app:trackColor="@color/card_border"
            app:trackCornerRadius="@dimen/radius_full"
            app:trackThickness="10dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layout_study"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/spacing_24"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_16"
        app:layout_constraintBottom_toTopOf="@id/layout_rating"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_progress">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_study"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="@dimen/elevation_low"
            app:strokeColor="@color/card_border"
            app:strokeWidth="@dimen/card_stroke_width">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card_front"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/spacing_24">

                    <TextView
                        android:id="@+id/text_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:textAppearance="@style/TextAppearance.VocabMaster.Caption"
                        android:textColor="@color/brand_primary"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="IELTS"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/image_card"
                        android:layout_width="140dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="@dimen/spacing_24"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_tag"
                        tools:src="@drawable/macdinh"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/text_term"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.VocabMaster.Display"
                        android:textColor="@color/text_primary"
                        app:layout_constraintBottom_toTopOf="@id/text_flip_hint"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/image_card"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="abundant" />

                    <TextView
                        android:id="@+id/text_flip_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:text="Chạm để xem nghĩa"
                        android:textAppearance="@style/TextAppearance.VocabMaster.BodyMedium"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_term" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/spacing_24"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/text_definition"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.VocabMaster.H2"
                        android:textColor="@color/text_primary"
                        app:layout_constraintBottom_toTopOf="@id/text_example"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="existing in large quantities" />

                    <TextView
                        android:id="@+id/text_example"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.VocabMaster.BodyLarge"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/text_definition"
                        tools:text="The garden has abundant flowers."
                        tools:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layout_rating"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_16"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_easy"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/spacing_8"
            android:layout_weight="1"
            android:text="Dễ"
            android:textColor="@color/success"
            app:backgroundTint="@color/light_green"
            app:cornerRadius="@dimen/radius_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_medium"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="@dimen/spacing_4"
            android:layout_weight="1"
            android:text="Vừa"
            android:textColor="@color/warning"
            app:backgroundTint="@color/light_yellow"
            app:cornerRadius="@dimen/radius_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hard"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="@dimen/spacing_8"
            android:layout_weight="1"
            android:text="Khó"
            android:textColor="@color/error"
            app:backgroundTint="@color/light_red"
            app:cornerRadius="@dimen/radius_medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_24"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/text_state_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.VocabMaster.H2"
            android:textColor="@color/text_primary"
            tools:text="Hoàn thành phiên ôn tập" />

        <TextView
            android:id="@+id/text_state_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.VocabMaster.BodyLarge"
            android:textColor="@color/text_secondary"
            tools:text="Bạn đã ôn 12 thẻ và nhận 24 XP." />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_study_sets"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_24"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:visibility="gone"
            tools:itemCount="3"
            tools:listitem="@layout/item_srs_study_set"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_state_primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/spacing_24"
            android:text="Quay lại"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="@dimen/radius_medium" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
